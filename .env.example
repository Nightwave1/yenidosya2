# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oleum

# --- Redis (optional in dev: cache/WS fanout/reminders degrade gracefully without it) ---
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=4000
JWT_SECRET=dev-only-change-me-32+chars

# --- Public booking base used in links/templates ---
APP_BASE_URL=http://localhost:5173
